PORT=5000

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/skillswap?retryWrites=true&w=majority

# Use a long, random string in production — never reuse the dev value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Deployed frontend URL(s). Comma-separate multiple origins
# e.g. http://localhost:5173,https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

NODE_ENV=development
